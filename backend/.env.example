# Which LLM backend to use: mock | anthropic | openai
#   mock      -> no API key needed, deterministic extractive output (default)
#   anthropic -> needs ANTHROPIC_API_KEY
#   openai    -> needs OPENAI_API_KEY; set OPENAI_BASE_URL for Ollama / Groq / OpenRouter etc.
LLM_PROVIDER=mock
# Optional model override. Defaults: anthropic=claude-sonnet-5-5, openai=gpt-4o-mini
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# e.g. http://localhost:11434/v1 for Ollama (any non-empty OPENAI_API_KEY works there)
OPENAI_BASE_URL=

# Embeddings for retrieval: fastembed (local ONNX model, downloaded once ~70 MB) | hash (no download, lower quality)
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Where PDFs + SQLite live
DATA_DIR=./data
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Host names the API will answer to (matched against the Host header, no port; "*.example.com" wildcards work).
# A deployment on a custom domain MUST add its domain here, or every request gets 400 "Invalid host header".
# Keep `backend` if the frontend container proxies to it (docker compose).
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],backend

# Chunk size for retrieval, in estimated embedder tokens. Keep CHUNK_TOKENS under the embedder's window (bge-small: 512).
# Changing either value (or the embedding model) rebuilds the index of existing papers on the next start.
CHUNK_TOKENS=450
CHUNK_OVERLAP_TOKENS=60

# Optional: shrink the summary pipeline for small token-per-minute quotas (e.g. Groq free tier = 8000 TPM)
# SUMMARY_SINGLE_PASS_TOKENS=4000
# SUMMARY_MAP_GROUP_TOKENS=3000
# TOP_K=4
